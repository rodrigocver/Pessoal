# Postgres local para desenvolvimento. Em produção (Fase 7): string do Supabase ou Neon.
DATABASE_URL=postgres://fiscaliza:fiscaliza@localhost:5432/fiscaliza

# Auth.js — gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=troque-por-um-segredo-local
# Opcionais (Fase 7). Sem eles, o login é por link mágico impresso no terminal.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# EMAIL_FROM="Fiscaliza <nao-responda@seu-dominio>"

# URL pública do site (links nos e-mails)
APP_URL=http://localhost:3000

# Renovação do cache das páginas depois da ingestão (POST /api/revalidar). Gere com: openssl rand -hex 32
# REVALIDAR_SEGREDO=
# Conexões por instância do servidor (padrão 10; use 3 em serverless com pooler)
# DATABASE_POOL_MAX=
